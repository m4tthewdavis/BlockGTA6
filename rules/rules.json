  "youtube": {
    "channelIds": [],
    "$comment": "Rockstar Games' own channel is intentionally NOT blocked wholesale: it also posts GTA Online / Red Dead content. Its GTA 6 uploads are caught by the keyword match."
  },
  "reddit": {
    "subreddits": [
      "GTA6",
      "GTAVI"
    ]
  },
  "domains": {
    "$comment": "hostRegex is RE2-compatible (no lookarounds) and is applied to the full URL of top-level page loads. It must only look at the host part.",
    "hostRegex": "^https?://[^/?#]*(gta-?6[^0-9/?#]|gta-?vi[^a-z0-9/?#]|grandtheftauto-?6[^0-9/?#]|grandtheftauto-?vi[^a-z0-9/?#])",
    "urlPrefixes": [
      "rockstargames.com/VI",
      "reddit.com/r/GTA6",
      "reddit.com/r/GTAVI",
      "twitch.tv/directory/category/grand-theft-auto-vi",
      "tiktok.com/tag/gta6",
      "tiktok.com/tag/gtavi",
      "instagram.com/explore/tags/gta6",
      "instagram.com/explore/tags/gtavi"
    ],
    "$urlPrefixesComment": "Host + path prefix; any subdomain (www., old., new.) and either scheme matches. Case-insensitive."
  },
  "allowlist": []
