{
  "$comment": "Safehouse (repo: BlockGTA6) shared rules. DATA ONLY - no executable code. Every client (extension, Android, iOS) loads this file and applies it with the algorithm described in rules/README.md. Scope: ALL GTA 6 / GTA VI content. Older GTA games (GTA 5, GTA Online, Vice City 2002) must NOT be blocked by default.",
  "version": 3,
  "updated": "2026-11-13",
  "scope": "gta6",
  "regex": [
    {
      "id": "gta-6",
      "pattern": "\\bg ?t ?a ?6(?![0-9])"
    },
    {
      "id": "gta-vi",
      "pattern": "\\bg ?t ?a ?vi(?![a-z0-9])"
    },
    {
      "id": "gta-six",
      "pattern": "\\bg ?t ?a ?six(?![a-z])"
    },
    {
      "id": "gtavi-tag",
      "pattern": "\\bgtavi(trailer|trailers|leak|leaks|news|online|map|gameplay|release|hype|memes?)\\b"
    },
    {
      "id": "gta-sixth",
      "pattern": "\\bsixth (gta|grand theft auto)\\b"
    },
    {
      "id": "gta-next",
      "pattern": "\\b(next|new|upcoming) (gta|grand theft auto)( game)?\\b(?! online)(?! 5)(?! v\\b)(?! trilogy)(?! definitive)"
    },
    {
      "id": "grand-theft",
      "pattern": "\\bgrand ?theft ?auto ?(6|vi|six)(?![a-z0-9])"
    }
  ],
  "unique": [
    "jason duval",
    "lucia caminos",
    "leonida",
    "leonida keys",
    "port gellhorn",
    "grassrivers",
    "mount kalaga",
    "boobie ike",
    "dre quan priest",
    "real dimez",
    "raul bautista",
